# Copia este archivo como .env y reemplaza los valores de ejemplo.
# .env esta ignorado por Git y nunca debe subirse al repositorio.
DB_URL=jdbc:postgresql://TU_HOST/fulbito_dev?sslmode=verify-full&channelBinding=require
DB_USERNAME=TU_USUARIO
DB_PASSWORD=TU_PASSWORD

# En produccion, usa un rol migrador distinto del rol diario de la API.
FLYWAY_DB_URL=jdbc:postgresql://TU_HOST/fulbito_dev?sslmode=verify-full&channelBinding=require
FLYWAY_DB_USERNAME=TU_USUARIO_MIGRADOR
FLYWAY_DB_PASSWORD=TU_PASSWORD_MIGRADOR

JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

JWT_EXPIRATION=PT2H
APP_OPENAPI_ENABLED=false

# Mantener false al ejecutar localmente por HTTP. Usar true en staging y produccion HTTPS.
REQUIRE_HTTPS=false

CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
CLOUDINARY_API_KEY=TU_API_KEY
CLOUDINARY_API_SECRET=TU_API_SECRET
