# Copia este archivo como .env y reemplaza los valores de ejemplo.
# .env esta ignorado por Git y nunca debe subirse al repositorio.
DB_URL=jdbc:postgresql://TU_HOST/fulbito_dev?sslmode=require&channelBinding=require
DB_USERNAME=TU_USUARIO
DB_PASSWORD=TU_PASSWORD
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
CLOUDINARY_API_KEY=TU_API_KEY
CLOUDINARY_API_SECRET=TU_API_SECRET
